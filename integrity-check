#!/usr/bin/env bash

set -o nounset

BASE_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
BASELINE_DIR="$BASE_DIR/baseline"
BASELINE_FILE="$BASELINE_DIR/hashes.txt"

usage() {
    cat <<EOF
Usage:
  ./integrity-check init <file-or-directory>
  ./integrity-check check <file-or-directory>
  ./integrity-check update <file>
EOF
}

die() {
    echo "Error: $*" >&2
    exit 1
}

calculate_hash() {
    sha256sum -- "$1" | cut -d ' ' -f 1
}

collect_files() {
    local target="$1"

    [[ -e "$target" ]] || die "Path does not exist: $target"

    if [[ -f "$target" ]]; then
        printf '%s\n' "$target"
    elif [[ -d "$target" ]]; then
        find "$target" -type f -print
    else
        die "Target must be a regular file or directory"
    fi
}

init_baseline() {
    local target="$1"
    local temp_file
    local file
    local hash

    [[ ! -e "$BASELINE_FILE" ]] ||
        die "Baseline already exists. Remove it explicitly to reinitialize."

    mkdir -p "$BASELINE_DIR" || die "Cannot create baseline directory"
    chmod 700 "$BASELINE_DIR" || die "Cannot secure baseline directory"

    temp_file="$(mktemp "$BASELINE_DIR/.hashes.XXXXXX")" ||
        die "Cannot create temporary baseline"

    while IFS= read -r -d '' file; do
        [[ -r "$file" ]] || {
            rm -f "$temp_file"
            die "Cannot read file: $file"
        }

        hash="$(calculate_hash "$file")" || {
            rm -f "$temp_file"
            die "Failed to hash file: $file"
        }

        printf '%s\t%s\n' "$hash" "$file" >> "$temp_file" || {
            rm -f "$temp_file"
            die "Failed to write baseline"
        }
    done < <(
        if [[ -f "$target" ]]; then
            printf '%s\0' "$target"
        elif [[ -d "$target" ]]; then
            find "$target" -type f -print0
        else
            die "Target must be a regular file or directory"
        fi
    )

    chmod 600 "$temp_file" || die "Cannot secure temporary baseline"
    mv -- "$temp_file" "$BASELINE_FILE" || die "Cannot save baseline"

    echo "Hashes stored successfully."
    echo "Baseline: $BASELINE_FILE"
}

check_integrity() {
    local target="$1"
    local current_hash
    local expected_hash
    local file
    local status=0
    local found

    [[ -f "$BASELINE_FILE" ]] ||
        die "Baseline not found. Run init first."

    while IFS= read -r -d '' file; do
        current_hash="$(calculate_hash "$file")" ||
            die "Failed to hash file: $file"

        found=0
        expected_hash=""

        while IFS=$'\t' read -r expected_hash baseline_path; do
            if [[ "$baseline_path" == "$file" ]]; then
                found=1
                break
            fi
        done < "$BASELINE_FILE"

        if [[ "$found" -eq 0 ]]; then
            echo "[NEW]      $file"
            status=1
        elif [[ "$current_hash" != "$expected_hash" ]]; then
            echo "[MODIFIED] $file"
            status=1
        else
            echo "[OK]       $file"
        fi
    done < <(
        if [[ -f "$target" ]]; then
            printf '%s\0' "$target"
        elif [[ -d "$target" ]]; then
            find "$target" -type f -print0
        else
            die "Target must be a regular file or directory"
        fi
    )

    while IFS=$'\t' read -r expected_hash file; do
        if [[ ! -f "$file" ]]; then
            echo "[MISSING]  $file"
            status=1
        fi
    done < "$BASELINE_FILE"

    return "$status"
}

update_baseline() {
    local target="$1"
    local temp_file
    local file
    local hash

    [[ -f "$BASELINE_FILE" ]] ||
        die "Baseline not found. Run init first."

    [[ -f "$target" && -r "$target" ]] ||
        die "Update requires a readable, existing file: $target"

    temp_file="$(mktemp "$BASELINE_DIR/.hashes.XXXXXX")" ||
        die "Cannot create temporary baseline"

    # Pertahankan semua entri kecuali file yang diperbarui
    while IFS=$'\t' read -r old_hash file; do
        [[ "$file" == "$target" ]] && continue
        printf '%s\t%s\n' "$old_hash" "$file" >> "$temp_file" ||
            die "Failed to copy baseline"
    done < "$BASELINE_FILE"

    # Tambahkan hash terbaru
    hash="$(calculate_hash "$target")" || {
        rm -f "$temp_file"
        die "Failed to hash file: $target"
    }

    printf '%s\t%s\n' "$hash" "$target" >> "$temp_file" || {
        rm -f "$temp_file"
        die "Failed to write baseline"
    }

    chmod 600 "$temp_file" || die "Cannot secure temporary baseline"
    mv -- "$temp_file" "$BASELINE_FILE" || die "Cannot save baseline"

    echo "Baseline updated for: $target"
}

main() {
    if [[ $# -lt 2 ]]; then
        usage
        exit 1
    fi

    local command="$1"
    local target="$2"

    case "$command" in
        init)
            init_baseline "$target"
            ;;
        check)
            check_integrity "$target"
            ;;
        update)
            update_baseline "$target"
            ;;
        *)
            echo "Error: Unknown command '$command'" >&2
            usage
            exit 1
            ;;
    esac
}

main "$@"
